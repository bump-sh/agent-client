{
  "name": "@bump-sh/agent-monorepo",
  "private": true,
  "type": "module",
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "all": "npm run build && npm run check && npm run test",
    "build": "npm run build --workspaces --if-present",
    "playground": "npm run dev -w @bump-sh/agent-playground",
    "test": "npm run test --workspaces --if-present",
    "check": "biome check packages",
    "format": "biome format --write packages"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "esbuild": "0.28.2",
    "happy-dom": "^20.14.5",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^5.0.2"
  },
  "version": "0.4.0"
}
